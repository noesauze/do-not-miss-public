#include? "Local.xcconfig"

APP_DEVELOPMENT_TEAM = YOUR_TEAM_ID
APP_BUNDLE_IDENTIFIER = com.example.DoNotMiss
GOOGLE_CLIENT_ID = GOOGLE_CLIENT_ID_PLACEHOLDER.apps.googleusercontent.com
GOOGLE_CALLBACK_SCHEME = com.googleusercontent.apps.GOOGLE_CLIENT_ID_PLACEHOLDER
GOOGLE_REDIRECT_URI = com.googleusercontent.apps.GOOGLE_CLIENT_ID_PLACEHOLDER:/oauth-callback

DEVELOPMENT_TEAM = $(APP_DEVELOPMENT_TEAM)
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)
